{
  "name": "@orionis-framework/realtime-client",
  "version": "1.0.0",
  "description": "Dependency-free JavaScript client for the Orionis Realtime v1 JSON protocol.",
  "keywords": [
    "orionis",
    "realtime",
    "websocket",
    "rpc",
    "streams",
    "typescript"
  ],
  "author": {
    "name": "rmunate",
    "url": "https://github.com/rmunate"
  },
  "homepage": "https://docs.orionis-framework.com/en/realtime/javascript-client/",
  "type": "module",
  "main": "./orionis-realtime.js",
  "module": "./orionis-realtime.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./orionis-realtime.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "test:types": "tsc -p test/tsconfig.json && tsc -p test/tsconfig.json --module ESNext --moduleResolution Bundler",
    "test:package": "node scripts/test-package.mjs",
    "check": "node --check orionis-realtime.js && npm test && npm run test:types && npm run test:package",
    "prepack": "npm run check"
  },
  "files": [
    "orionis-realtime.js",
    "index.d.ts",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orionis-framework/realtime-client.git"
  },
  "bugs": {
    "url": "https://github.com/orionis-framework/realtime-client/issues"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
